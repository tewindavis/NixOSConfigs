font-family = "JetBrainsMono Nerd Font"
font-size = 12

background-opacity = 0.7
background-blur = true

# Slick Window & UI
window-decoration = false
confirm-close-surface = false
cursor-style = block
cursor-style-blink = true

# Tokyo Night Night palette; mirrored in the TTY's console.colors
# (modules/core/default.nix)
background = 0a0b10
foreground = c0caf5
selection-background = 3b3d4d
selection-foreground = c0caf5
cursor-color = 7aa2f7

palette = 0=#15161e
palette = 8=#414868
palette = 1=#f7768e
palette = 9=#f7768e
palette = 2=#9ece6a
palette = 10=#9ece6a
palette = 3=#e0af68
palette = 11=#e0af68
palette = 4=#7aa2f7
palette = 12=#7aa2f7
palette = 5=#bb9af7
palette = 13=#bb9af7
palette = 6=#7dcfff
palette = 14=#7dcfff
palette = 7=#a9b1d6
palette = 15=#c0caf5

# Cursor trail (shaders/cursor_trail.glsl): a fading smear when the cursor
# jumps two or more cells. Path is ~/-based because this config file is a
# symlink into the Nix store, and relative paths resolve against it.
# Shaders run an animation loop while a Ghostty window is focused
# (custom-shader-animation defaults to true; Ghostty documents it as
# generally under 10% CPU). Setting it to false would stop the trail
# animating at all.
custom-shader = ~/.config/ghostty/shaders/cursor_trail.glsl
